# Elasticsearch cluster endpoint
ES_URL=
ES_TIMEOUT_SECONDS=
ES_MAX_CONNECTIONS=

# Optional authentication (leave empty for unauthenticated local clusters)
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_VERIFY_CERTS=true

# The single index this app reads
INDEX_RERA=

# Optional: only used by the pipeline-simulation panel
PIPELINE_ID=

# Always false for this project
ALLOW_WRITES=
